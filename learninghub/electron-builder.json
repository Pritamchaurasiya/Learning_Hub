{
  "appId": "com.learninghub.desktop",
  "productName": "LearningHub",
  "copyright": "Copyright © 2026 LearningHub",
  "directories": {
    "output": "dist-desktop-bin",
    "buildResources": "public"
  },
  "asar": true,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "files": ["dist/**/*", "electron/**/*", "public/**/*", "package.json", "!**/node_modules/**"],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "icon": "public/app-icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "LearningHub Desktop"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  }
}
