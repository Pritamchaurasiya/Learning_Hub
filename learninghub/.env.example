# LearningHub Frontend Environment Variables

# API Configuration (FRONTEND - VITE_ prefixed, exposed to browser)
VITE_API_URL=/api/v1

# Google Analytics 4 (Production only, requires user consent)
# Get your Measurement ID from Google Analytics dashboard
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Flags (optional)
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_API=false

# Build Configuration
VITE_BUILD_ANALYZE=false
