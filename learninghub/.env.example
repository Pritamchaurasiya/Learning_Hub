# LearningHub Frontend Environment Variables

# API Configuration (FRONTEND - VITE_ prefixed, exposed to browser)
VITE_API_URL=/api/v1

# Google Analytics 4 (Production only, requires user consent)
# Get your Measurement ID from Google Analytics dashboard
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Flags (optional)
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_API=false

# Build Configuration
VITE_BUILD_ANALYZE=false

# =====================================================================
# BACKEND ENVIRONMENT VARIABLES (shared / backend-only)
#
# The variables below are NOT prefixed with VITE_ and are never exposed
# to the browser. They are consumed by the backend service. Keep these
# values secret and do not commit real secrets to version control. Empty secret values must be filled before startup.
# =====================================================================

# --- Backend / Shared (Backend only) ---

# Docker Compose database credentials (required; no insecure compose defaults).
DB_USER=learninghub
DB_PASSWORD=
DB_NAME=learninghub

# Primary database connection string (used by the ORM / app queries).
# Use the connection string from your database provider (e.g. Supabase, Neon, Postgres).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Direct database connection string (bypasses connection pooler).
# Required for migrations / Prisma CLI operations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Secret used to sign access (short-lived) JWTs.
JWT_SECRET=

# Secret used to sign refresh (long-lived) JWTs.
JWT_REFRESH_SECRET=

# Allowed CORS origin(s) for the backend API (comma-separated if multiple).
CORS_ORIGIN=http://localhost:5173

# Public URL of the frontend, used by the backend for links / redirects.
FRONTEND_URL=http://localhost:5173

# Secret used to generate and validate CSRF tokens.
CSRF_SECRET=
SECRET_KEY=

# Secret required to access admin-only endpoints / bootstrap operations.
ADMIN_SECRET=

# Default admin account email used during initial setup / seeding.
ADMIN_EMAIL=admin@example.com

# Default admin account password used during initial setup / seeding.
ADMIN_DEFAULT_PASSWORD=
STUDENT_DEFAULT_PASSWORD=

# Whether the backend should use Redis (true / false).
REDIS_ENABLED=false

# Redis connection URL (only used when REDIS_ENABLED=true).
REDIS_PASSWORD=
REDIS_URL=redis://:replace-with-a-unique-long-redis-password@localhost:6379/0

# API key for Google Gemini (used for AI features in the backend).
GEMINI_API_KEY=replace-with-your-gemini-api-key
