# LearningHub Django Backend — local development template
# Never commit a real .env file. Use Render Environment settings for deployments.

DEBUG=True
DJANGO_SETTINGS_MODULE=learninghub_server.settings
DJANGO_SECRET_KEY=local-development-only-change-me
JWT_SECRET_KEY=local-development-only-change-me
ADMIN_SECRET=local-development-only-change-me

# Local PostgreSQL for development. Replace with an isolated Neon staging URL
# only when explicitly testing against that staging database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/learninghub_django

# Local origins; production initially uses https://learninghub-385.pages.dev.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local single-process development fallback. Production must use Redis.
ALLOW_IN_MEMORY_BACKENDS=true

# Optional integrations
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
