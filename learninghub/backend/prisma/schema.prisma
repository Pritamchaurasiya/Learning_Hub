  @@index([userId, completed])
  @@index([userId, type, deadline], map: "idx_user_goal_type_deadline")
  @@map("user_goals")
}

model RecommendationFeedback {
  id               String   @id @default(uuid())
  userId           String
  recommendationId String
  action           String
  outcome          String?
  scoreChange      Float?
  timeToComplete   Int?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([recommendationId])
  @@map("recommendation_feedback")
}

model AIProvider {
  id          String           @id @default(uuid())
  name        AIProviderName   @unique
  displayName String
  apiKey      String?
  baseUrl     String?
  status      AIProviderStatus @default(ACTIVE)
  config      Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  models             AIModel[]
  generationRequests AIGenerationRequest[]

  @@index([status])
  @@map("ai_providers")
}

model AIModel {
  id              String   @id @default(uuid())
  providerId      String
  name            String
  modelId         String
  type            String
  capabilities    Json
  costPer1kTokens Float?
  maxTokens       Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([type])
  @@index([isActive])
  @@map("ai_models")
}

model PromptTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  template    String
  variables   String[]
  modelType   String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([isActive])
  @@map("prompt_templates")
}

model AIGenerationRequest {
  id               String    @id @default(uuid())
  userId           String?
  providerId       String
  modelId          String
  promptTemplateId String?
  input            Json
  output           Json?
  validationResult Json?
  guardrailResult  Json?
  status           String    @default("PENDING")
  latencyMs        Int?
  tokensUsed       Int?
  cost             Float?
  error            String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  provider           AIProvider               @relation(fields: [providerId], references: [id], onDelete: Restrict)
  outputs            AIGenerationOutput[]
  validations        AIGenerationValidation[]
  guardrailDecisions AIGuardrailDecision[]
  costLogs           AICostLog[]

  @@index([userId, createdAt])
  @@index([providerId, modelId, createdAt])
  @@index([status, createdAt])
  @@map("ai_generation_requests")
}

model AIGenerationOutput {
  id                  String   @id @default(uuid())
  generationRequestId String
  outputType          String
  content             Json
  version             Int      @default(1)
  isPublished         Boolean  @default(false)
  createdAt           DateTime @default(now())

  generationRequest AIGenerationRequest @relation(fields: [generationRequestId], references: [id], onDelete: Cascade)

  @@index([generationRequestId])
  @@map("ai_generation_outputs")
}

model AIGenerationValidation {
  id                  String   @id @default(uuid())
  generationRequestId String
  validatorType       String
  passed              Boolean
  details             Json
  createdAt           DateTime @default(now())

  generationRequest AIGenerationRequest @relation(fields: [generationRequestId], references: [id], onDelete: Cascade)

  @@index([generationRequestId])
  @@map("ai_generation_validations")
}

model AIGuardrailDecision {
  id                  String   @id @default(uuid())
  generationRequestId String
  decisionType        String
  action              String
  reason              String?
  metadata            Json?
  createdAt           DateTime @default(now())

  generationRequest AIGenerationRequest @relation(fields: [generationRequestId], references: [id], onDelete: Cascade)

  @@index([generationRequestId])
  @@map("ai_guardrail_decisions")
}

model AICostLog {
  id                  String   @id @default(uuid())
  generationRequestId String
  providerId          String
  modelId             String
  userId              String?
  tokensInput         Int      @default(0)
  tokensOutput        Int      @default(0)
  cost                Float    @default(0)
  currency            String   @default("USD")
  createdAt           DateTime @default(now())

  generationRequest AIGenerationRequest @relation(fields: [generationRequestId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([providerId, modelId, createdAt])
  @@map("ai_cost_logs")
}

model AIEvalResult {
  id         String   @id @default(uuid())
  evalSetId  String
  modelId    String
  providerId String
  score      Float
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([evalSetId, modelId])
  @@index([createdAt])
  @@map("ai_eval_results")
}
