  qualityScore  Float?
  createdBy     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  bank             QuestionBank              @relation(fields: [bankId], references: [id], onDelete: Cascade)
  versions         QuestionVersion[]
  options          CanonicalQuestionOption[]
  concepts         QuestionConcept[]
  topics           QuestionTopic[]
  assets           QuestionAsset[]
  qualityMetrics   QuestionQualityMetric[]
  reviews          QuestionReview[]
  flags            QuestionFlag[]
  similarityHashes QuestionSimilarityHash[]

  @@index([bankId, status])
  @@index([type, status, difficulty, language])
  @@index([status, createdAt])
  @@index([isAiGenerated])
  @@index([qualityScore])
  @@index([createdBy])
  @@map("canonical_questions")
}

