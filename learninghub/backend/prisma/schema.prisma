generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "metrics"]
  engineType      = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                    @id @default(uuid())
  email                String                    @unique
  password             String
  username             String?
  role                 UserRole                  @default(STUDENT)
  xp                   Int                       @default(0)
  level                Int                       @default(1)
  streak               Int                       @default(0)
  longestStreak        Int                       @default(0)
  lastActive           DateTime                  @default(now())
  lastLoginAt          DateTime?
  loginCount           Int                       @default(0)
  failedLogins         Int                       @default(0)
  lockedUntil          DateTime?
  emailVerified        Boolean                   @default(false)
  emailVerifiedAt      DateTime?
  mfaEnabled           Boolean                   @default(false)
  mfaSecret            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  deletedAt            DateTime?
  avatar               String?
  bio                  String?
  location             String?
  website              String?
  dateOfBirth          DateTime?
  timezone             String                    @default("UTC")
  preferredLanguage    String                    @default("en")
  countryId            String?
  experimentEvents     ExperimentEvent[]
  activityLogs         ActivityLog[]
  auditLogs            AuditLog[]
  dailyGoals           DailyGoal[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
  submissions          ProblemSubmission[]
  questionBookmarks    QuestionBookmark[]
  refreshTokens        RefreshToken[]
  testResults          TestResult[]
  topicPerformances    TopicPerformance[]
  achievements         UserAchievement[]
  examPreference       UserExamPreference?
  sessions             UserSession[]
  country              Country?                  @relation("UserCountry", fields: [countryId], references: [id], onDelete: SetNull)
  verificationToken    VerificationToken?
  aiChatSessions       AIChatSession[]
  dailyStats           UserDailyStats[]
  performanceSnapshots UserPerformanceSnapshot[]

  @@index([role, deletedAt], map: "idx_user_role_active")
  @@index([email, emailVerified], map: "idx_user_email_verified")
  @@index([lastActive(sort: Desc)], map: "idx_user_last_active")
  @@index([xp(sort: Desc), id(sort: Asc)], map: "idx_user_xp_id")
  @@index([deletedAt, xp(sort: Desc), id(sort: Asc)], map: "idx_user_leaderboard")
  @@index([username], map: "idx_user_username")
  @@index([createdAt(sort: Desc)], map: "idx_user_created_at")
  @@map("users")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  name          String
  description   String
  icon          String?
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([unlockedAt])
  @@index([userId, unlockedAt(sort: Desc)], map: "idx_user_achievement_unlocked")
  @@map("user_achievements")
}

model Test {
  id            String                   @id @default(uuid())
  examId        String?
  title         String
  description   String?
  timeLimit     Int                      @default(15)
  passingScore  Int                      @default(60)
  maxAttempts   Int                      @default(3)
  mode          TestMode                 @default(MOCK)
  difficulty    TestDifficulty           @default(MIXED)
  totalMarks    Float                    @default(0)
  negativeMarks Float                    @default(0)
  isPublished   Boolean                  @default(true)
  isAiGenerated Boolean                  @default(false)
  templateId    String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  deletedAt     DateTime?
  search_vector Unsupported("tsvector")?
  questions     Question[]
  results       TestResult[]
  exam          Exam?                    @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([examId, isPublished], map: "idx_test_exam_published")
  @@index([isPublished, mode, difficulty, createdAt(sort: Desc)], map: "idx_test_discover")
  @@index([isAiGenerated, isPublished], map: "idx_test_ai_published")
  @@index([deletedAt], map: "idx_test_deleted_at")
  @@index([search_vector], type: Gin, map: "idx_test_search_vector")
  @@index([mode, isPublished, deletedAt], map: "idx_test_mode_active")
  @@index([templateId], map: "idx_test_template")
  @@index([title], map: "idx_test_title")
  @@map("tests")
}

model Question {
  id                String              @id @default(uuid())
  testId            String
  topicId           String?
  text              String
  type              QuestionType        @default(MCQ)
  difficulty        Float               @default(0.5)
  bloomLevel        BloomLevel          @default(UNDERSTAND)
  explanation       String?
  solutionSteps     Json?
  tags              String[]
  isAiGenerated     Boolean             @default(false)
  points            Int                 @default(10)
  order             Int
  options           Option[]
  bookmarks         QuestionBookmark[]
  test              Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  topic             Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  TestAttemptAnswer TestAttemptAnswer[]

  @@index([testId], map: "idx_question_test")
  @@index([topicId], map: "idx_question_topic")
  @@index([type], map: "idx_question_type")
  @@index([difficulty], map: "idx_question_difficulty")
  @@index([isAiGenerated], map: "idx_question_ai_generated")
  @@index([bloomLevel], map: "idx_question_bloom_level")
  @@index([testId, order], map: "idx_question_test_order")
  @@map("questions")
}

model Option {
  id          String   @id @default(uuid())
  questionId  String
  text        String
  isCorrect   Boolean  @default(false)
  explanation String?
  order       Int      @default(0)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId], map: "idx_option_question")
  @@index([questionId, isCorrect], map: "idx_option_question_correct")
  @@map("options")
}

model TestResult {
  id             String              @id @default(uuid())
  userId         String
  testId         String
  attemptNumber  Int                 @default(1)
  score          Int
  cbmScore       Int                 @default(0)
  totalPoints    Int
  percentage     Float
  passed         Boolean
  timeTaken      Int
  status         AttemptStatus       @default(IN_PROGRESS)
  completedAt    DateTime?
  startedAt      DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  test           Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptAnswers TestAttemptAnswer[]

  @@unique([userId, testId, attemptNumber])
  @@index([userId, testId, status], map: "idx_result_user_test_status")
  @@index([userId, status, completedAt(sort: Desc)], map: "idx_result_user_status_completed")
  @@index([status, completedAt(sort: Desc)], map: "idx_result_status_completed")
  @@index([userId, status, percentage(sort: Desc)], map: "idx_result_user_status_score")
  @@index([startedAt(sort: Desc)], map: "idx_result_started_at")
  @@index([testId, status], map: "idx_result_test_status")
  @@index([userId, testId], map: "idx_result_user_test")
  @@index([percentage], map: "idx_result_percentage")
  @@map("test_results")
}

model TestAttemptAnswer {
  id           String @id @default(uuid())
  testResultId String
  questionId   String
  selectedOptions String[]
  textAnswer      String?
  confidence      String?
  timeSpent       Int      @default(0)
  isCorrect     Boolean?
  marksObtained Int?
  aiFeedback    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testResultId, questionId])
  @@index([testResultId])
  @@index([questionId])
  @@index([isCorrect])
  @@index([testResultId, questionId], map: "idx_attempt_answer_result_question")
  @@index([testResultId, isCorrect], map: "idx_attempt_answer_result_correct")
  @@map("test_attempt_answers")
}

model Problem {
  id            String                   @id @default(uuid())
  title         String
  slug          String                   @unique
  description   String
  difficulty    DifficultyLevel          @default(INTERMEDIATE)
  category      String
  tags          String[]
  points        Int                      @default(100)
  starterCode   String?
  testCases     String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  deletedAt     DateTime?
  submissions   ProblemSubmission[]
  search_vector Unsupported("tsvector")?

  @@index([difficulty, deletedAt], map: "idx_problem_difficulty_active")
  @@index([category, difficulty, deletedAt], map: "idx_problem_browse")
  @@index([createdAt(sort: Desc)], map: "idx_problem_created_at")
  @@index([search_vector], type: Gin, map: "idx_problem_search_vector")
  @@index([slug], map: "idx_problem_slug")
  @@index([deletedAt, category, difficulty, createdAt(sort: Desc)], map: "idx_problem_listing")
  @@index([deletedAt, tags], map: "idx_problem_tags")
  @@map("problems")
}

model ProblemSubmission {
  id            String              @id @default(uuid())
  userId        String
  problemId     String
  code          String
  language      ProgrammingLanguage @default(JAVASCRIPT)
  status        SubmissionStatus    @default(PENDING)
  executionTime Int?
  memoryUsed    Int?
  submittedAt   DateTime            @default(now())
  problem       Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_submission_user")
  @@index([problemId], map: "idx_submission_problem")
  @@index([userId, problemId], map: "idx_submission_user_problem")
  @@index([userId, problemId, submittedAt(sort: Desc)], map: "idx_submission_user_problem_date")
  @@index([userId, status], map: "idx_submission_user_status")
  @@index([status], map: "idx_submission_status")
  @@index([submittedAt], map: "idx_submission_submitted_at")
  @@index([language], map: "idx_submission_language")
  @@map("problem_submissions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  message   String
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_notification_user_read_time")
  @@index([userId, type, createdAt(sort: Desc)], map: "idx_notification_user_type_time")
  @@index([createdAt(sort: Desc)], map: "idx_notification_created_at")
  @@index([userId, isRead], map: "idx_notification_user_read")
  @@map("notifications")
}

model DailyGoal {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @default(now()) @db.Date
  targetMinutes    Int      @default(30)
  completedMinutes Int      @default(0)
  completed        Boolean  @default(false)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([userId, date, completed], map: "idx_daily_goal_status")
  @@map("daily_goals")
}

model ActivityLog {
  id           String       @id @default(uuid())
  userId       String
  activityType ActivityType
  entityType   String?
  entityId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  sessionId    String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_activity_log_user_time")
  @@index([userId, activityType, createdAt(sort: Desc)], map: "idx_activity_log_user_type_time")
  @@index([entityType, entityId], map: "idx_activity_log_entity")
  @@index([createdAt], map: "idx_activity_log_created_at")
  @@index([activityType], map: "idx_activity_log_type")
  @@map("activity_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  revokedBy String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([userId, createdAt], map: "idx_refresh_token_user_created_at")
  @@index([userId, expiresAt], map: "idx_refresh_token_user_expires")
  @@index([usedAt], map: "idx_refresh_token_used")
  @@map("refresh_tokens")
}

model UserSession {
  id            String    @id @default(uuid())
  userId        String
  sessionToken  String    @unique
  deviceId      String?
  deviceName    String?
  deviceType    String?
  ipAddress     String?
  userAgent     String?
  location      String?
  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken], map: "idx_session_token")
  @@index([userId, expiresAt, isRevoked], map: "idx_session_validation")
  @@index([userId, isRevoked, lastUsedAt(sort: Desc)], map: "idx_session_active_recent")
  @@index([userId, isRevoked], map: "idx_session_user_active")
  @@map("user_sessions")
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  action      AuditAction
  entityType  String?
  entityId    String?
  oldValues   Json?
  newValues   Json?
  description String?
  severity    Severity    @default(INFO)
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_log_user_time")
  @@index([action, severity, createdAt(sort: Desc)], map: "idx_audit_log_action_severity_time")
  @@index([entityType, entityId, createdAt(sort: Desc)], map: "idx_audit_log_entity_time")
  @@index([entityType, entityId], map: "idx_audit_log_entity")
  @@index([createdAt(sort: Desc)], map: "idx_audit_log_created")
  @@map("audit_logs")
}

model PYQ {
  id            String   @id @default(uuid())
  examType      ExamType
  examId        String?
  subjectName   String?
  subjectId     String?
  year          Int
  paper         String
  question      String
  options       String[]
  answer        String
  explanation   String
  difficulty    String
  marks         Int      @default(1)
  negativeMarks Float    @default(0)
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  exam          Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([examType, year])
  @@index([examId])
  @@index([subjectId])
  @@index([subjectName])
  @@index([difficulty])
  @@index([examType, difficulty, year])
  @@map("pyqs")
}

model Formula {
  id          String   @id @default(uuid())
  examType    ExamType
  subjectId   String?
  topic       String
  name        String
  formula     String
  description String
  variables   Json?
  examples    String[]
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([examType, subjectId])
  @@index([subjectId])
  @@index([topic])
  @@index([examType, topic])
  @@map("formulas")
}

model RevisionNote {
  id        String   @id @default(uuid())
  examType  ExamType
  subjectId String?
  topic     String
  content   String
  keyPoints String[]
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([examType, subjectId])
  @@index([subjectId])
  @@index([topic])
  @@index([examType, topic])
  @@map("revision_notes")
}

model Country {
  id              String               @id @default(uuid())
  code            String               @unique
  name            String
  flagEmoji       String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  exams           Exam[]
  userPreferences UserExamPreference[]
  users           User[]               @relation("UserCountry")

  @@index([code])
  @@index([isActive])
  @@index([name])
  @@map("countries")
}

model Exam {
  id              String               @id @default(uuid())
  countryId       String
  name            String
  slug            String               @unique
  description     String?
  pattern         Json?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  country         Country              @relation(fields: [countryId], references: [id], onDelete: Restrict)
  pyqs            PYQ[]
  subjects        Subject[]
  templates       TestTemplate[]
  tests           Test[]
  userPreferences UserExamPreference[]
  search_vector   Unsupported("tsvector")?

  @@index([countryId])
  @@index([slug])
  @@index([isActive])
  @@index([deletedAt], map: "idx_exam_deleted_at")
  @@index([name], map: "idx_exam_name")
  @@index([search_vector], type: Gin, map: "idx_exam_search_vector")
  @@index([deletedAt, isActive, name], map: "idx_exam_listing")
  @@map("exams")
}

model Subject {
  id              String               @id @default(uuid())
  examId          String
  name            String
  slug            String               @unique
  icon            String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  formulas        Formula[]
  pyqs            PYQ[]
  revisionNotes   RevisionNote[]
  exam            Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  templates       TestTemplate[]
  topics          Topic[]
  userPreferences UserExamPreference[]

  @@index([examId])
  @@index([slug])
  @@index([deletedAt], map: "idx_subject_deleted_at")
  @@index([name], map: "idx_subject_name")
  @@map("subjects")
}

model Topic {
  id             String                   @id @default(uuid())
  subjectId      String
  name           String
  slug           String                   @unique
  order          Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?
  questions      Question[]
  subject        Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  blueprintRules TestBlueprintTopicRule[]
  QuestionTopic  QuestionTopic[]

  @@index([subjectId])
  @@index([slug])
  @@index([deletedAt], map: "idx_topic_deleted_at")
  @@index([name], map: "idx_topic_name")
  @@index([subjectId, order], map: "idx_topic_subject_order")
  @@map("topics")
}

model TestTemplate {
  id             String         @id @default(uuid())
  name           String
  description    String?
  examId         String?
  subjectId      String?
  topicIds       String[]
  difficulty     TestDifficulty @default(MIXED)
  mode           TestMode       @default(PRACTICE)
  questionCount  Int            @default(10)
  timeLimit      Int            @default(15)
  promptTemplate String
  isPublished    Boolean        @default(false)
  usageCount     Int            @default(0)
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  exam           Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  subject        Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([subjectId])
  @@index([difficulty])
  @@index([mode])
  @@index([isPublished])
  @@index([createdBy])
  @@map("test_templates")
}

model UserExamPreference {
  id         String         @id @default(uuid())
  userId     String         @unique
  countryId  String?
  examId     String?
  subjectIds String[]
  difficulty TestDifficulty @default(MEDIUM)
  dailyGoal  Int            @default(10)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  country    Country?       @relation(fields: [countryId], references: [id], onDelete: SetNull)
  exam       Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  subjects   Subject[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
  @@map("user_exam_preferences")
}

model AIChatSession {
  id        String          @id @default(uuid())
  userId    String
  title     String
  messages  AIChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
  @@index([userId, updatedAt], map: "idx_ai_session_user_updated_at")
  @@map("ai_chat_sessions")
}

model AIChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  role      ChatRole      @default(USER)
  content   String
  metadata  Json?
  createdAt DateTime      @default(now())
  session   AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@index([sessionId, createdAt], map: "idx_ai_message_session_time")
  @@map("ai_chat_messages")
}

model QuestionBookmark {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  notes      String?
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@index([userId, createdAt(sort: Desc)], map: "idx_bookmark_user_created")
  @@map("question_bookmarks")
}

model TopicPerformance {
  id             String    @id @default(uuid())
  userId         String
  topicId        String
  topicName      String?
  subjectName    String?
  totalAttempts  Int       @default(0)
  correctAnswers Int       @default(0)
  accuracy       Float     @default(0)
  avgTimeSeconds Float     @default(0)
  lastAttemptAt  DateTime?
  strengthLevel  String    @default("unknown")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([accuracy])
  @@index([strengthLevel])
  @@index([userId, accuracy], map: "idx_topic_perf_user_accuracy")
  @@index([userId, lastAttemptAt], map: "idx_topic_perf_user_last_attempt")
  @@index([userId, totalAttempts, accuracy], map: "idx_topic_perf_user_attempts_accuracy")
  @@map("topic_performances")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model ExperimentEvent {
  id           String   @id @default(uuid())
  experimentId String
  variant      String
  userId       String
  event        String
  value        Float    @default(0)
  createdAt    DateTime @default(now())
