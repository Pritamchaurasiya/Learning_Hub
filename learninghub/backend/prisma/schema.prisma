model CanonicalQuestion {
  id            String             @id @default(uuid())
  bankId        String
  type          QuestionType       @default(MCQ)
  status        QuestionStatus     @default(DRAFT)
  provenance    QuestionProvenance @default(MANUAL)
  difficulty    Float              @default(0.5)
  bloomLevel    BloomLevel         @default(UNDERSTAND)
  language      String             @default("en")
  stem          String
  prompt        String?
  explanation   String?
  solutionSteps Json?
  tags          String[]
