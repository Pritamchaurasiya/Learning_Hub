generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "metrics"]
  engineType      = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  username            String?
  role                UserRole             @default(STUDENT)
  xp                  Int                  @default(0)
  level               Int                  @default(1)
  streak              Int                  @default(0)
  longestStreak       Int                  @default(0)
  lastActive          DateTime             @default(now())
  lastLoginAt         DateTime?
  loginCount          Int                  @default(0)
  failedLogins        Int                  @default(0)
  lockedUntil         DateTime?
  emailVerified       Boolean              @default(false)
  emailVerifiedAt     DateTime?
  mfaEnabled          Boolean              @default(false)
  mfaSecret           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  avatar              String?
  bio                 String?
  location            String?
  website             String?
  dateOfBirth         DateTime?
  timezone            String               @default("UTC")
  preferredLanguage   String               @default("en")
  countryId           String?
  experimentEvents    ExperimentEvent[]
  mentorProfile       Mentor?              @relation("MentorProfile")
  notes               Note[]
  activityLogs        ActivityLog[]
  auditLogs           AuditLog[]
  bookmarks           Bookmark[]
  certificates        Certificate[]
  contestParticipants ContestParticipant[]
  courseReviews       CourseReview[]
  coursesTaught       Course[]             @relation("UserCoursesTaught")
  dailyGoals          DailyGoal[]
  lessonCompletions   LessonCompletion[]
  liveSessions        LiveSession[]        @relation("LiveSessionInstructor")
  mentoring           MentorshipSession[]  @relation("MentorMentorship")
  mentorships         MentorshipSession[]  @relation("UserMentorship")
  NFTCertificate      NFTCertificate[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  submissions         ProblemSubmission[]
  questionBookmarks   QuestionBookmark[]
  refreshTokens       RefreshToken[]
  subscription        Subscription?
  testResults         TestResult[]
  topicPerformances   TopicPerformance[]
  achievements        UserAchievement[]
  examPreference      UserExamPreference?
  progress            UserProgress[]
  sessions            UserSession[]
  country             Country?             @relation("UserCountry", fields: [countryId], references: [id], onDelete: SetNull)
  verificationToken   VerificationToken?
  Web3Profile         Web3Profile?
  cart                Cart?
  aiChatSessions      AIChatSession[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([emailVerified])
  @@index([lastActive], map: "idx_user_last_active")
  @@map("users")
}

model Course {
  id               String           @id @default(uuid())
  title            String
  description      String
  shortDescription String?
  phase            CoursePhase
  duration         Int
  difficulty       DifficultyLevel
  category         String?
  tags             String[]
  content          String
  thumbnail        String?
  trailerVideo     String?
  instructorId     String?
  price            Decimal?         @default(0) @db.Decimal(10, 2)
  originalPrice    Decimal?         @db.Decimal(10, 2)
  currency         String           @default("USD")
  rating           Float            @default(0)
  reviewCount      Int              @default(0)
  studentCount     Int              @default(0)
  certificate      Boolean          @default(false)
  language         String           @default("en")
  prerequisites    String[]
  learningOutcomes String[]
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  lastUpdated      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  notes            Note[]
  bookmarks        Bookmark[]
  certificates     Certificate[]
  reviews          CourseReview[]
  instructor       User?            @relation("UserCoursesTaught", fields: [instructorId], references: [id])
  modules          Module[]
  nftCertificates  NFTCertificate[]
  tests            Test[]
  progress         UserProgress[]
  cartItems        CartItem[]

  @@index([difficulty], map: "idx_course_difficulty")
  @@index([phase], map: "idx_course_phase")
  @@index([category], map: "idx_course_category")
  @@index([createdAt], map: "idx_course_created_at")
  @@index([price], map: "idx_course_price")
  @@index([isPublished], map: "idx_course_is_published")
  @@index([deletedAt], map: "idx_course_deleted_at")
  @@index([instructorId], map: "idx_course_instructor")
  @@index([rating], map: "idx_course_rating")
  @@index([studentCount], map: "idx_course_student_count")
  @@index([language], map: "idx_course_language")
  @@index([certificate], map: "idx_course_certificate")
  @@index([phase, difficulty], map: "idx_course_phase_difficulty")
  @@index([category, rating], map: "idx_course_category_rating")
  @@index([isPublished, rating], map: "idx_course_published_rating")
  @@map("courses")
}

model UserProgress {
  id               String         @id @default(uuid())
  userId           String
  courseId         String
  progress         Int            @default(0)
  status           ProgressStatus @default(NOT_STARTED)
  timeSpentSeconds Int            @default(0)
  completedAt      DateTime?
  lastActivityAt   DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId], name: "idx_unique_user_course")
  @@index([userId], map: "idx_progress_user")
  @@index([courseId], map: "idx_progress_course")
  @@index([status], map: "idx_progress_status")
  @@index([updatedAt], map: "idx_progress_updated_at")
  @@index([completedAt], map: "idx_progress_completed_at")
  @@index([userId, status], map: "idx_progress_user_status")
  @@index([userId, lastActivityAt], map: "idx_progress_user_last_activity")
  @@index([courseId, status], map: "idx_progress_course_status")
  @@map("user_progress")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId], name: "idx_unique_user_course_bookmark")
  @@index([userId], map: "idx_bookmark_user")
  @@index([courseId], map: "idx_bookmark_course")
  @@map("bookmarks")
}

model Lesson {
  id          String             @id @default(uuid())
  moduleId    String
  title       String
  description String?
  content     String?
  duration    Int
  order       Int
  isFree      Boolean            @default(true)
  videoUrl    String?
  transcript  String?
  resources   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  notes       Note[]
  completions LessonCompletion[]
  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, order], name: "idx_unique_module_order")
  @@index([moduleId], map: "idx_lesson_module")
  @@index([isFree], map: "idx_lesson_is_free")
  @@map("lessons")
}

model LessonCompletion {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId], name: "idx_unique_user_lesson")
  @@index([userId], map: "idx_completion_user")
  @@index([lessonId], map: "idx_completion_lesson")
  @@index([completedAt], map: "idx_completion_completed_at")
  @@map("lesson_completions")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  name          String
  description   String
  icon          String?
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([unlockedAt])
  @@map("user_achievements")
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  lessonId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lessonId])
  @@index([userId, courseId])
  @@index([lessonId])
  @@index([courseId])
  @@index([createdAt])
  @@map("notes")
}

model Test {
  id            String         @id @default(uuid())
  courseId      String?
  examId        String?
  title         String
  description   String?
  timeLimit     Int            @default(15)
  passingScore  Int            @default(60)
  mode          TestMode       @default(MOCK)
  difficulty    TestDifficulty @default(MIXED)
  totalMarks    Float          @default(0)
  negativeMarks Float          @default(0)
  isPublished   Boolean        @default(true)
  isAiGenerated Boolean        @default(false)
  templateId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  questions     Question[]
  results       TestResult[]
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam          Exam?          @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "idx_test_course")
  @@index([examId], map: "idx_test_exam")
  @@index([createdAt], map: "idx_test_created_at")
  @@index([mode], map: "idx_test_mode")
  @@index([difficulty], map: "idx_test_difficulty")
  @@index([isPublished], map: "idx_test_published")
  @@index([isAiGenerated], map: "idx_test_ai_generated")
  @@index([isPublished, mode, createdAt], map: "idx_test_published_mode_created")
  @@index([isPublished, difficulty, createdAt], map: "idx_test_published_difficulty_created")
  @@map("tests")
}

model Question {
  id                 String              @id @default(uuid())
  testId             String
  topicId            String?
  text               String
  type               String              @default("mcq")
  difficulty         Float               @default(0.5)
  bloomLevel         String              @default("understand")
  explanation        String?
  solutionSteps      Json?
  tags               String[]
  isAiGenerated      Boolean             @default(false)
  points             Int                 @default(10)
  order              Int
  contestProblems    ContestProblem[]
  contestSubmissions ContestSubmission[]
  options            Option[]
  bookmarks          QuestionBookmark[]
  test               Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  topic              Topic?              @relation(fields: [topicId], references: [id])

  @@index([testId], map: "idx_question_test")
  @@index([topicId], map: "idx_question_topic")
  @@index([type], map: "idx_question_type")
  @@index([difficulty], map: "idx_question_difficulty")
  @@index([isAiGenerated], map: "idx_question_ai_generated")
  @@map("questions")
}

model Option {
  id          String   @id @default(uuid())
  questionId  String
  text        String
  isCorrect   Boolean  @default(false)
  explanation String?
  order       Int      @default(0)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId], map: "idx_option_question")
  @@index([questionId, isCorrect], map: "idx_option_question_correct")
  @@map("options")
}

model TestResult {
  id              String        @id @default(uuid())
  userId          String
  testId          String
  attemptNumber   Int           @default(1)
  score           Int
  totalPoints     Int
  percentage      Float
  passed          Boolean
  timeTaken       Int
  answers         Json
  questionResults Json?
  status          AttemptStatus @default(IN_PROGRESS)
  completedAt     DateTime?
  startedAt       DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  test            Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, testId, attemptNumber])
  @@index([userId, testId])
  @@index([userId, status, completedAt])
  @@index([userId, testId, status])
  @@index([completedAt])
  @@index([status])
  @@index([attemptNumber])
  @@index([percentage])
  @@index([passed])
  @@index([status, completedAt], map: "idx_test_result_status_completed_at")
  @@index([userId, completedAt], map: "idx_test_result_user_completed_at")
  @@index([startedAt], map: "idx_test_result_started_at")
  @@index([userId, status, percentage], map: "idx_test_result_user_status_percentage")
  @@map("test_results")
}

model Problem {
  id          String              @id @default(uuid())
  title       String
  slug        String              @unique
  description String
  difficulty  String
  category    String
  tags        String[]
  points      Int                 @default(100)
  starterCode String?
  testCases   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  submissions ProblemSubmission[]

  @@index([difficulty])
  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([category, difficulty], map: "idx_problem_category_difficulty")
  @@index([difficulty, createdAt], map: "idx_problem_difficulty_created_at")
  @@index([category, createdAt], map: "idx_problem_category_created_at")
  @@map("problems")
}

model ProblemSubmission {
  id            String   @id @default(uuid())
  userId        String
  problemId     String
  code          String
  language      String   @default("javascript")
  status        String
  executionTime Int?
  memoryUsed    Int?
  submittedAt   DateTime @default(now())
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_submission_user")
  @@index([problemId], map: "idx_submission_problem")
  @@index([userId, problemId], map: "idx_submission_user_problem")
  @@index([userId, status], map: "idx_submission_user_status")
  @@index([status], map: "idx_submission_status")
  @@index([submittedAt], map: "idx_submission_submitted_at")
  @@map("problem_submissions")
}

model LiveSession {
  id                  String   @id @default(uuid())
  title               String
  instructorId        String?
  instructorName      String
  scheduledAt         DateTime
  durationMinutes     Int
  status              String   @default("upcoming")
  maxParticipants     Int      @default(100)
  currentParticipants Int      @default(0)
  createdAt           DateTime @default(now())
  instructor          User?    @relation("LiveSessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  @@index([instructorId])
  @@index([instructorId, status], map: "idx_live_session_instructor_status")
  @@index([scheduledAt])
  @@index([status])
  @@index([status, scheduledAt])
  @@map("live_sessions")
}

model Mentor {
  id           String   @id @default(uuid())
  userId       String   @unique
  name         String
  title        String
  bio          String
  avatar       String?
  skills       String
  languages    String
  hourlyRate   Float
  rating       Float    @default(5.0)
  reviewsCount Int      @default(0)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation("MentorProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isAvailable])
  @@index([rating])
  @@map("mentors")
}

model MentorshipSession {
  id          String   @id @default(uuid())
  userId      String
  mentorId    String
  status      String   @default("pending")
  scheduledAt DateTime
  duration    Int      @default(60)
  createdAt   DateTime @default(now())
  mentor      User     @relation("MentorMentorship", fields: [mentorId], references: [id], onDelete: Cascade)
  user        User     @relation("UserMentorship", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mentorId])
  @@index([scheduledAt])
  @@index([status])
  @@map("mentorship_sessions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([isRead, createdAt], map: "idx_notification_read_created_at")
  @@index([type], map: "idx_notification_type")
  @@index([userId, type, createdAt], map: "idx_notification_user_type_created_at")
  @@map("notifications")
}

model Module {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
  @@index([courseId])
  @@map("modules")
}

model DailyGoal {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @default(now()) @db.Date
  targetMinutes    Int      @default(30)
  completedMinutes Int      @default(0)
  completed        Boolean  @default(false)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_goals")
}

model ActivityLog {
  id           String       @id @default(uuid())
  userId       String
  activityType ActivityType
  entityType   String?
  entityId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  sessionId    String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt], map: "idx_activity_log_user_created_at")
  @@index([userId, activityType], map: "idx_activity_log_user_type")
  @@map("activity_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  revokedBy String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([userId, createdAt], map: "idx_refresh_token_user_created_at")
  @@map("refresh_tokens")
}

model UserSession {
  id            String    @id @default(uuid())
  userId        String
  sessionToken  String    @unique
  deviceId      String?
  deviceName    String?
  deviceType    String?
  ipAddress     String?
  userAgent     String?
  location      String?
  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([isRevoked])
  @@index([expiresAt])
  @@index([deviceId])
  @@index([userId, expiresAt, isRevoked], map: "idx_user_session_validation")
  @@index([userId, isRevoked, lastUsedAt], map: "idx_user_session_active_sort")
  @@map("user_sessions")
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  action      AuditAction
  entityType  String?
  entityId    String?
  oldValues   Json?
  newValues   Json?
  description String?
  severity    Severity    @default(INFO)
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([severity])
  @@index([userId, createdAt], map: "idx_audit_log_user_created_at")
  @@index([action, createdAt], map: "idx_audit_log_action_created_at")
  @@index([severity, action], map: "idx_audit_log_severity_action")
  @@index([entityType, entityId, createdAt], map: "idx_audit_log_entity_created_at")
  @@map("audit_logs")
}

model CourseReview {
  id           String    @id @default(uuid())
  courseId     String
  userId       String
  rating       Int
  title        String?
  content      String?
  isVerified   Boolean   @default(false)
  helpfulCount Int       @default(0)
  reportCount  Int       @default(0)
  isVisible    Boolean   @default(true)
  moderatedAt  DateTime?
  moderatedBy  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewer     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@map("course_reviews")
}

model PYQ {
  id            String   @id @default(uuid())
  examType      ExamType
  examId        String?
  subjectName   String?
  subjectId     String?
  year          Int
  paper         String
  question      String
  options       String[]
  answer        String
  explanation   String
  difficulty    String
  marks         Int      @default(1)
  negativeMarks Float    @default(0)
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  exam          Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([examType, year])
  @@index([examId])
  @@index([subjectId])
  @@index([subjectName])
  @@index([difficulty])
  @@map("pyqs")
}

model Formula {
  id          String   @id @default(uuid())
  examType    ExamType
  subjectId   String?
  topic       String
  name        String
  formula     String
  description String
  variables   Json?
  examples    String[]
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([examType, subjectId])
  @@index([subjectId])
  @@index([topic])
  @@map("formulas")
}

model RevisionNote {
  id        String   @id @default(uuid())
  examType  ExamType
  subjectId String?
  topic     String
  content   String
  keyPoints String[]
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([examType, subjectId])
  @@index([subjectId])
  @@index([topic])
  @@map("revision_notes")
}

model Country {
  id              String               @id @default(uuid())
  code            String               @unique
  name            String
  flagEmoji       String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  exams           Exam[]
  userPreferences UserExamPreference[]
  users           User[]               @relation("UserCountry")

  @@index([code])
  @@index([isActive])
  @@map("countries")
}

model Exam {
  id              String               @id @default(uuid())
  countryId       String
  name            String
  slug            String               @unique
  description     String?
  pattern         Json?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  country         Country              @relation(fields: [countryId], references: [id])
  pyqs            PYQ[]
  subjects        Subject[]
  templates       TestTemplate[]
  tests           Test[]
  userPreferences UserExamPreference[]

  @@index([countryId])
  @@index([slug])
  @@index([isActive])
  @@map("exams")
}

model Subject {
  id            String         @id @default(uuid())
  examId        String
  name          String
  slug          String         @unique
  icon          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  formulas      Formula[]
  pyqs          PYQ[]
  revisionNotes RevisionNote[]
  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  templates     TestTemplate[]
  topics        Topic[]

  @@index([examId])
  @@index([slug])
  @@map("subjects")
}

model Topic {
  id        String     @id @default(uuid())
  subjectId String
  name      String
  slug      String     @unique
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([slug])
  @@map("topics")
}

model TestTemplate {
  id             String         @id @default(uuid())
  name           String
  description    String?
  examId         String?
  subjectId      String?
  topicIds       String[]
  difficulty     TestDifficulty @default(MIXED)
  mode           TestMode       @default(PRACTICE)
  questionCount  Int            @default(10)
  timeLimit      Int            @default(15)
  promptTemplate String
  isPublished    Boolean        @default(false)
  usageCount     Int            @default(0)
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  exam           Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  subject        Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([subjectId])
  @@index([difficulty])
  @@index([mode])
  @@index([isPublished])
  @@map("test_templates")
}

model UserExamPreference {
  id         String         @id @default(uuid())
  userId     String         @unique
  countryId  String?
  examId     String?
  subjectIds String[]
  difficulty TestDifficulty @default(MEDIUM)
  dailyGoal  Int            @default(10)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  country    Country?       @relation(fields: [countryId], references: [id])
  exam       Exam?          @relation(fields: [examId], references: [id])
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
  @@map("user_exam_preferences")
}

model AIChatSession {
  id        String          @id @default(uuid())
  userId    String
  title     String
  messages  AIChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
  @@map("ai_chat_sessions")
}

model AIChatMessage {
  id          String        @id @default(uuid())
  sessionId   String
  role        String        // 'user' | 'assistant'
  content     String
  metadata    Json?
  createdAt   DateTime      @default(now())
  session     AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_chat_messages")
}

model SubscriptionTier {
  id            String               @id @default(uuid())
  name          String               @unique
  displayName   String
  description   String?
  price         Decimal              @db.Decimal(10, 2)
  currency      String               @default("USD")
  interval      SubscriptionInterval @default(MONTHLY)
  trialDays     Int                  @default(0)
  features      Json
  limits        Json
  isActive      Boolean              @default(true)
  stripePriceId String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions Subscription[]

  @@index([isActive])
  @@map("subscription_tiers")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  tierId               String
  status               SubscriptionStatus @default(TRIAL)
  stripeSubscriptionId String?
  stripeCustomerId     String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tier                 SubscriptionTier   @relation(fields: [tierId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLimits          UsageLimit[]

  @@index([userId])
  @@index([tierId])
  @@index([status])
  @@map("subscriptions")
}

model UsageLimit {
  id                String       @id @default(uuid())
  subscriptionId    String
  period            DateTime
  testsTaken        Int          @default(0)
  aiGenerations     Int          @default(0)
  questionsAnswered Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, period])
  @@index([subscriptionId])
  @@index([period])
  @@map("usage_limits")
}

model Coupon {
  id                String   @id @default(uuid())
  code              String   @unique
  description       String?
  discountType      String
  discountValue     Decimal  @db.Decimal(10, 2)
  maxUses           Int?
  usedCount         Int      @default(0)
  validFrom         DateTime
  validUntil        DateTime
  applicableTierIds String[]
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([validUntil])
  @@map("coupons")
}

model QuestionBookmark {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  notes      String?
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("question_bookmarks")
}

model TopicPerformance {
  id             String    @id @default(uuid())
  userId         String
  topicId        String?
  topicName      String
  subjectName    String?
  totalAttempts  Int       @default(0)
  correctAnswers Int       @default(0)
  accuracy       Float     @default(0)
  avgTimeSeconds Float     @default(0)
  lastAttemptAt  DateTime?
  strengthLevel  String    @default("unknown")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicName])
  @@index([userId])
  @@index([accuracy])
  @@index([strengthLevel])
  @@index([userId, accuracy], map: "idx_topic_perf_user_accuracy")
  @@index([userId, lastAttemptAt], map: "idx_topic_perf_user_last_attempt")
  @@index([userId, totalAttempts, accuracy], map: "idx_topic_perf_user_attempts_accuracy")
  @@map("topic_performances")
}

model Contest {
  id               String               @id @default(uuid())
  title            String
  slug             String               @unique
  description      String?
  type             ContestType          @default(WEEKLY)
  difficulty       ContestDifficulty    @default(MEDIUM)
  status           ContestStatus        @default(UPCOMING)
  startTime        DateTime
  endTime          DateTime
  duration         Int
  problemCount     Int                  @default(0)
  participantCount Int                  @default(0)
  prize            String?
  rules            String?
  isPublished      Boolean              @default(false)
  createdBy        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  participants     ContestParticipant[]
  problems         ContestProblem[]
  submissions      ContestSubmission[]

  @@index([status])
  @@index([startTime])
  @@index([type])
  @@index([difficulty])
  @@index([isPublished])
  @@map("contests")
}

model ContestProblem {
  id         String   @id @default(uuid())
  contestId  String
  questionId String
  order      Int      @default(0)
  points     Int      @default(10)
  createdAt  DateTime @default(now())
  contest    Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([contestId, questionId])
  @@index([contestId])
  @@index([questionId])
  @@map("contest_problems")
}

model ContestParticipant {
  id             String              @id @default(uuid())
  contestId      String
  userId         String
  score          Int                 @default(0)
  rank           Int?
  problemsSolved Int                 @default(0)
  totalTime      Int                 @default(0)
  joinedAt       DateTime            @default(now())
  lastSubmitAt   DateTime?
  contest        Contest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions    ContestSubmission[]

  @@unique([contestId, userId])
  @@index([contestId])
  @@index([userId])
  @@index([score])
  @@index([rank])
  @@map("contest_participants")
}

model ContestSubmission {
  id            String             @id @default(uuid())
  contestId     String
  participantId String
  questionId    String
  code          String?
  language      String?
  status        String             @default("pending")
  points        Int                @default(0)
  timeTaken     Int                @default(0)
  submittedAt   DateTime           @default(now())
  contest       Contest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  participant   ContestParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question      Question           @relation(fields: [questionId], references: [id])

  @@index([contestId])
  @@index([participantId])
  @@index([questionId])
  @@index([status])
  @@index([submittedAt])
  @@map("contest_submissions")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Certificate {
  id             String   @id @default(uuid())
  userId         String
  courseId       String
  certificateUrl String
  issuedAt       DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

model ExperimentEvent {
  id           String   @id @default(uuid())
  experimentId String
  variant      String
  userId       String
  event        String
  value        Float    @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([experimentId, variant])
  @@index([userId])
  @@index([createdAt])
  @@map("experiment_events")
}

model Web3Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  walletAddress String?  @unique
  did           String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletAddress])
  @@map("web3_profiles")
}

model NFTCertificate {
  id              String   @id @default(uuid())
  userId          String
  courseId        String
  tokenId         String   @unique
  merkleRoot      String
  merkleProof     String[]
  transactionHash String   @unique
  metadataUri     String
  isRevoked       Boolean  @default(false)
  createdAt       DateTime @default(now())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

@@unique([userId, courseId])
   @@index([tokenId])
   @@index([userId])
   @@map("nft_certificates")
}

