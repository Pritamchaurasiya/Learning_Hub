# ============================================
# LearningHub Backend — Environment Configuration
# ============================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================

PORT=5000
NODE_ENV=development
BCRYPT_ROUNDS=12

# Database Configuration (format: postgresql://user:password@host:port/dbname)
DB_PROVIDER=postgresql
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/learninghub"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/learninghub"

# JWT Configuration — MUST use strong, unique secrets in production
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_a_random_64_char_string_here
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_random_64_char_string
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Logging Configuration (0=error, 1=warn, 2=info, 3=debug)
LOG_LEVEL=3

# Rate Limiting Configuration
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=10000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=1000
RATE_LIMIT_ADMIN_WINDOW_MS=900000
RATE_LIMIT_ADMIN_MAX=1000

# File Upload Configuration (Local)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/

# AWS / S3 Storage Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# Admin Configuration
ADMIN_SECRET=CHANGE_ME_min_32_chars_random_string
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_use_strong_password

# Audit Logging Configuration
AUDIT_LOG_TO_CONSOLE=true
AUDIT_LOG_TO_DATABASE=false
AUDIT_LOG_RETENTION_DAYS=90

# Redis Configuration (optional — enables distributed caching and WebSocket scaling)
# Format: redis://:password@host:port
# Set REDIS_ENABLED=true when Redis is running
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# AI Configuration (Multiple Providers)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Code Execution (DSA Sandbox)
# PISTON_API_URL=http://localhost:2000/api/v2 # Use for local docker-compose.piston.yml
# PISTON_API_URL=https://emkc.org/api/v2/piston # Public fallback (may return 401)

# CSRF Protection — REQUIRED, must be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CSRF_SECRET=CHANGE_ME_use_a_random_64_char_hex_string_here_minimum_32

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn-here

# Stripe Payment Configuration (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URL (for payment redirects)
FRONTEND_URL=http://localhost:5173

# Test Configuration
MAX_TEST_ATTEMPTS=3
DATABASE_URL_REPLICA=postgresql://postgres:password@localhost:5432/learninghub_replica