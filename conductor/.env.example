# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-dev-your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - Default uses SQLite if DATABASE_URL is not set
# For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/learninghub

# Redis (optional for development - uses in-memory by default)
# REDIS_URL=redis://localhost:6379/0

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend URL
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# AI API Keys (optional for development)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
