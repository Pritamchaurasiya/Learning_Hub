    {
      "id": "d153a4cf-9c93-447c-c053-485ff6525aad",
      "name": "03 — Security & Access Control",
      "item": [
        {
          "id": "2470ae56-c272-e6c7-6320-6b00fe23d78a",
          "name": "Current User — reject anonymous access",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me",
                ""
              ]
            },
            "description": "Negative security check: Django auth/me is protected by the me_view in conductor/apps/users/urls/auth.py. Expected 401 or 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Anonymous profile request is rejected', function () { pm.expect(pm.response.code).to.be.oneOf([401, 403]); });",
                  "pm.test('Anonymous request does not expose a profile', function () { pm.expect(pm.response.code).not.to.equal(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ],
  "auth": {
