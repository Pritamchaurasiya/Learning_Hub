{
  "info": {
    "_postman_id": "5069fbb3-02c1-4c81-bd0e-c83f3f3e1d07",
    "name": "LearningHub — API Quality & Regression Suite (Django DRF)",
    "description": "Canonical Django REST Framework API regression collection. Source references: README.md, API_CONTRACT.md and BACKEND_TRUTH.md. Configure baseUrl for the target environment. Smoke folders are GET-only; authentication flow requests are manual/local and require a dedicated non-production account.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "id": "19a41c84-96fb-4f54-a2e2-c7077a25b20c",
      "name": "00 — Health",
      "item": [
        {
          "id": "7b2017f1-0af7-4edf-b391-4efd4ed95445",
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Django health endpoint returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Django health check completes within 2 seconds', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
                  "const body = pm.response.json();",
                  "pm.test('Django health reports healthy service', function () { pm.expect(body.status).to.equal('healthy'); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "id": "926d90f7-872e-4076-b1db-3f3d6446e770",
      "name": "01 — Authentication",
      "item": [
        {
          "id": "d4395076-213b-47c8-b69b-a77ae3be14b0",
          "name": "Login — obtain JWT pair",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const body = pm.response.json();",
                  "const access = body?.data?.tokens?.access || body?.tokens?.access || body?.data?.access || body?.access;",
                  "const refresh = body?.data?.tokens?.refresh || body?.tokens?.refresh || body?.data?.refresh || body?.refresh;",
                  "pm.test('Login response contains an access token', function () { pm.expect(access, 'access token').to.be.a('string').and.not.empty; });",
                  "pm.test('Login response contains a refresh token', function () { pm.expect(refresh, 'refresh token').to.be.a('string').and.not.empty; });",
                  "if (access) pm.environment.set('accessToken', access);",
                  "if (refresh) pm.environment.set('refreshToken', refresh);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "id": "cca6aa29-5d2e-4ba0-bc44-048d926bc1fc",
          "name": "Refresh — rotate JWT pair",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh returns 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const access = body?.data?.accessToken || body?.data?.tokens?.access || body?.tokens?.access || body?.data?.access || body?.access;",
                  "const refresh = body?.data?.refreshToken || body?.data?.tokens?.refresh || body?.tokens?.refresh || body?.data?.refresh || body?.refresh;",
                  "pm.test('Refresh response contains a new access token', function () { pm.expect(access, 'access token').to.be.a('string').and.not.empty; });",
                  "pm.test('Refresh response contains the rotated refresh token', function () { pm.expect(refresh, 'refresh token').to.be.a('string').and.not.empty; });",
                  "if (access) pm.environment.set('accessToken', access);",
                  "if (refresh) pm.environment.set('refreshToken', refresh);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "id": "bf42f272-7ef4-4230-bfdb-494b6846e0c1",
          "name": "Current User — authenticated profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current-user endpoint returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Current-user response is a JSON object', function () { pm.expect(pm.response.json()).to.be.an('object'); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "id": "e73edd8d-0752-4500-8d84-5911642be76f",
      "name": "02 — Learning & Assessment",
      "item": [
        {
          "id": "47634470-b0a0-4f92-8da4-21a3eaeb13ea",
          "name": "List Published Courses",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Course catalog is available', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Course catalog returns a JSON object', function () { pm.expect(body).to.be.an('object'); });",
                  "pm.test('Course catalog follows the documented response envelope', function () { pm.expect(body).to.have.property('status'); pm.expect(body).to.have.property('data'); });"
                ]
              }
            }
          ],
          "response": []
        },
