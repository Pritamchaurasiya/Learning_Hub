# LearningHub root Docker Compose environment
# Copy to .env in the repository root and replace every placeholder with a unique secret.
# Never commit the populated .env file.

POSTGRES_DB=learninghub_prod
POSTGRES_USER=learninghub_admin
POSTGRES_PASSWORD=replace-with-a-unique-long-postgres-password
REDIS_PASSWORD=replace-with-a-unique-long-redis-password

# Django
SECRET_KEY=replace-with-a-unique-long-django-secret
JWT_SECRET_KEY=replace-with-a-unique-long-django-jwt-secret

# Express backend
JWT_SECRET=replace-with-a-unique-long-access-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-refresh-jwt-secret
CSRF_SECRET=replace-with-a-unique-long-csrf-secret
ADMIN_SECRET=replace-with-a-unique-long-admin-secret
ADMIN_EMAIL=admin@learninghub.prod
ADMIN_DEFAULT_PASSWORD=replace-with-a-unique-strong-admin-password
