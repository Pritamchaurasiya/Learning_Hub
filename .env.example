# LearningHub root Docker Compose environment
# Copy to .env in the repository root and generate/set every required secret before starting Compose.
# Empty secret values intentionally make Docker Compose fail fast until configured.
# Never commit the populated .env file.

POSTGRES_DB=learninghub_prod
POSTGRES_USER=learninghub_admin
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Django
SECRET_KEY=
JWT_SECRET_KEY=

# Express backend
JWT_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
ADMIN_SECRET=
ADMIN_EMAIL=admin@learninghub.prod
ADMIN_DEFAULT_PASSWORD=
